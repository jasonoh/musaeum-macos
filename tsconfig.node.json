{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "composite": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "out/types-node",
    "paths": {
      "@shared/*": ["./src/types/*"],
      "@ask/*": ["./shared/ask/*"]
    }
  },
  "include": [
    "electron/**/*.ts",
    "src/types/**/*.ts",
    "shared/**/*.ts",
    "electron.vite.config.ts",
    "test/**/*.ts"
  ]
}
